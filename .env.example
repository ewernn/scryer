# scryer environment variables. Copy to .env and fill in.
# See src/scryer/config.py for descriptions and defaults.

ENV=dev

# PostgreSQL (Neon in prod). Use postgresql+asyncpg:// scheme.
DATABASE_URL=postgresql+asyncpg://scryer:scryer@localhost:5432/scryer

# Cloudflare R2 — for Trace blobs and large artifacts.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=scryer-blobs

# AES-GCM key for Credentials encryption. Generate via:
#   python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# JWT signing secret for human session auth. Generate via:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_TTL_SECONDS=3600

# Sentry (optional; leave empty to disable).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
